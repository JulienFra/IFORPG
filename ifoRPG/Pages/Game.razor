@page "/game"
@using ifoRPG.Models
@using Microsoft.AspNetCore.Components.Web

<h3>ifoRPG</h3>

<div class="game-layout">

    <div class="left-panel">
        <p><b>Inventaire</b></p>
        @if (!player.Inventory.Items.Any())
        {
            <p>(vide)</p>
        }
        else
        {
            @foreach (var item in player.Inventory.Items)
            {
                <p>📦 @item.Name</p>
            }
        }
    </div>

    <div class="center-panel">
        <div class="map" tabindex="0" @onkeydown="HandleKey" @ref="gameDiv">

            @for (int y = 0; y < map.Height; y++)
            {
                <div class="row">
                    @for (int x = 0; x < map.Width; x++)
                    {
                        @* 1. INITIALISATION *@
                                string tileClass = "floor";
                        string rotationClass = "";

                        @* 2. LOGIQUE DES PC ET ROTATIONS *@
                                @if (!state.InCorridor && map.Tiles[x, y].Type == TileType.PC)
                        {
                            tileClass = "tile-pc";

                            // Tes 3 PC verticaux en X7 : rotation 90°
                            if (x == 7 && (y == 4 || y == 5 || y == 6))
                            {
                                rotationClass = "right";
                            }
                            // Ta rangée du haut : rotation 180°
                            else if (y == 3 && x >= 1 && x <= 7)
                            {
                                rotationClass = "up";
                            }
                        }
                        @* 3. LOGIQUE PORTE (X0, Y5) ET FENÊTRE *@
                                else if ((state.InCorridor && (x == 2 || x == 5 || x == 8) && y == 4) ||
                (!state.InCorridor && x == 0 && y == 5))
                        {
                            tileClass = "tile-door";
                        }
                        else if (!state.InCorridor && map.Tiles[x, y].Type == TileType.Window)
                        {
                            tileClass = "tile-window";
                        }

                        @* 4. RENDU DE LA CASE *@
                        <div class="tile @tileClass @rotationClass">

                            @if (player.X == x && player.Y == y)
                            {
                                @* Affichage du personnage player.png via le CSS *@
                                            <div class="player"></div>
                            }
                            else if (!state.InCorridor && !state.FloorsProgress[state.CurrentFloor][state.CurrentRoomIndex]
                            && x == map.BossX && y == map.BossY)
                            {
                                @* Si c'est le premier étage et la première salle, on affiche Jeremy *@
                if (state.CurrentFloor == 1 && state.CurrentRoomIndex == 0)
                                {
                                    <div class="boss-jeremy"></div>
                                }
                                else
                                {
                                    @* Pour les autres boss non encore créés, on garde l'emoji par défaut *@
                        <span class="boss-icon">👹</span>
                                }
                            }
                            else if (!state.InCorridor && map.Tiles[x, y].Type == TileType.Board)
                            {
                                <span class="boss-icon">👨‍🏫</span>
                            }
                            @* ESCALIERS *@
                                    else if (state.InCorridor && state.CurrentFloor < 3 && x == map.StairsX && y == map.StairsY)
                            {
                                <span class="boss-icon">@(state.FloorsProgress[state.CurrentFloor].All(r => r) ? "⬆️" :
                                                            "🚫⬆️")</span>
                                        }
                                        else if (state.InCorridor && state.CurrentFloor > 1 && x == 0 && y == 0)
                    {
                        <span class="boss-icon">⬇️</span>
                    }
                </div>
                                }
            </div>
                        }
        </div>
    </div>

    <div class="right-panel">
        <div class="quest-book">
            <p><b>Quest Book</b></p>
            <p>Étage @state.CurrentFloor</p>
            <ul>
                @for (int i = 0; i < 3; i++)
                {
                    <li>
                        Salle @(i + 1) :
                        @(state.FloorsProgress[state.CurrentFloor][i] ? "✅" : "❌")
                    </li>
                }
            </ul>
        </div>

        @if (!state.InCorridor && state.ShowBoss && state.CurrentBoss?.CurrentQuestion != null)
        {
            <div class="boss">
                <h3>👹 @state.CurrentBoss.Name</h3>
                <p>@state.CurrentBoss.CurrentQuestion.Text</p>

                @for (int i = 0; i < state.CurrentBoss.CurrentQuestion.Answers.Count; i++)
                {
                    int index = i;
                    <button @onclick="() => AnswerBoss(index)">
                        @state.CurrentBoss.CurrentQuestion.Answers[index]
                    </button>
                }
            </div>
        }
    </div>
</div>

@code {
    GameState state = new GameState();
    ElementReference gameDiv;

    private Player player => state.Player;
    private Map map => state.CurrentMap;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await gameDiv.FocusAsync();
    }

    void HandleKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "z": case "ArrowUp": player.Move(0, -1, map); break;
            case "s": case "ArrowDown": player.Move(0, 1, map); break;
            case "q": case "ArrowLeft": player.Move(-1, 0, map); break;
            case "d": case "ArrowRight": player.Move(1, 0, map); break;
        }
        CheckEvents();
    }

    void CheckEvents()
    {
        if (state.InCorridor)
        {
            bool allDone = state.FloorsProgress[state.CurrentFloor].All(r => r);
            if (state.CurrentFloor < 3 && allDone && player.X == map.StairsX && player.Y == map.StairsY)
                state.GoUp();

            if (state.CurrentFloor > 1 && player.X == 0 && player.Y == 0)
                state.GoDown();

            int[] doorX = { 2, 5, 8 };
            for (int i = 0; i < doorX.Length; i++)
            {
                if (player.X == doorX[i] && player.Y == 4) state.EnterRoom(i);
            }
        }
        else
        {
            // SORTIE PORTE (X0, Y5)
            if (player.X == 0 && player.Y == 5)
                state.ReturnToCorridor();

            if (!state.FloorsProgress[state.CurrentFloor][state.CurrentRoomIndex] &&
            player.X == map.BossX && player.Y == map.BossY)
                state.ShowBoss = true;
        }
    }

    void AnswerBoss(int index)
    {
        if (state.CurrentBoss == null) return;
        bool finished = state.CurrentBoss.Answer(index);
        if (finished) state.HandleBossDefeat(state.CurrentBoss.Defeated);
    }
}