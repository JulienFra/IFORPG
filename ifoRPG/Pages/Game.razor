@page "/game"
@using ifoRPG.Models
@using Microsoft.AspNetCore.Components.Web

<h3>ifoRPG</h3>

<div class="game-layout">

    <!-- INVENTAIRE -->
    <div class="left-panel">
        <p><b>Inventaire</b></p>

        @if (!player.Inventory.Items.Any())
        {
            <p>(vide)</p>
        }
        else
        {
            @foreach (var item in player.Inventory.Items)
            {
                <p>📦 @item.Name</p>
            }
        }
    </div>

    <!-- MAP -->
    <div class="center-panel">
        <div class="map"
             tabindex="0"
             @onkeydown="HandleKey"
             @ref="gameDiv">

            @for (int y = 0; y < map.Height; y++)
            {
                <div class="row">
                    @for (int x = 0; x < map.Width; x++)
                    {
                        if (player.X == x && player.Y == y)
                        {
                            <span class="tile">🙂</span>
                        }
                        // ESCALIER DE MONTÉE (ÉTAGE 1 ET 2 UNIQUEMENT)
                        else if (inCorridor &&
                                 currentFloor < 3 &&
                                 x == map.StairsX &&
                                 y == map.StairsY)
                        {
                            if (AllRoomsCompleted())
                                { <span class="tile">⬆️</span> }
                            else
                                { <span class="tile">🚫⬆️</span> }
                        }
                        // ESCALIER DE DESCENTE (HAUT GAUCHE)
                        else if (inCorridor &&
                                 currentFloor > 1 &&
                                 x == 0 && y == 0)
                        {
                            <span class="tile">⬇️</span>
                        }
                        else if (inCorridor &&
                                 doors.Any(d => d.x == x && d.y == y))
                        {
                            <span class="tile">🚪</span>
                        }
                        else if (!inCorridor &&
                                 x == exitDoorInRoom.x &&
                                 y == exitDoorInRoom.y)
                        {
                            <span class="tile">🚪</span>
                        }
                        else if (!inCorridor &&
                                 !CurrentRoomsCompleted()[currentRoom] &&
                                 x == map.BossX &&
                                 y == map.BossY)
                        {
                            <span class="tile">👹</span>
                        }
                        else
                        {
                            <span class="tile">.</span>
                        }
                    }
                </div>
            }
        </div>
    </div>

    <!-- QUEST BOOK + BOSS -->
    <div class="right-panel">

        <div class="quest-book">
            <p><b>Quest Book</b></p>
            <p>Étage @currentFloor</p>
            <ul>
                @for (int i = 0; i < 3; i++)
                {
                    <li>
                        Salle @(i + 1) :
                        @(CurrentRoomsCompleted()[i] ? "✅" : "❌")
                    </li>
                }
            </ul>
        </div>

        @if (!inCorridor && showBoss && boss!.CurrentQuestion != null)
        {
            <div class="boss">
                <h3>👹 @boss.Name</h3>
                <p>@boss.CurrentQuestion.Text</p>

                @for (int i = 0; i < boss.CurrentQuestion.Answers.Count; i++)
                {
                    int index = i;
                    <button @onclick="() => AnswerBoss(index)">
                        @boss.CurrentQuestion.Answers[i]
                    </button>
                }
            </div>
        }
    </div>
</div>

@code {
    int currentFloor = 1;
    int currentRoom = -1;
    bool inCorridor = true;

    Dictionary<int, bool[]> floorsProgress = new()
    {
        { 1, new bool[3] },
        { 2, new bool[3] },
        { 3, new bool[3] }
    };

    Map map = new Map(10, 10, 1);
    Player player = new Player(0, 0);

    Boss? boss;
    bool showBoss = false;

    (int x, int y)[] doors =
    {
        (2, 4),
        (5, 4),
        (8, 4)
    };

    (int x, int y) exitDoorInRoom;
    ElementReference gameDiv;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await gameDiv.FocusAsync();
    }

    bool[] CurrentRoomsCompleted() => floorsProgress[currentFloor];
    bool AllRoomsCompleted() => CurrentRoomsCompleted().All(r => r);

    void HandleKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "z":
            case "ArrowUp":
                player.Move(0, -1, map);
                break;
            case "s":
            case "ArrowDown":
                player.Move(0, 1, map);
                break;
            case "q":
            case "ArrowLeft":
                player.Move(-1, 0, map);
                break;
            case "d":
            case "ArrowRight":
                player.Move(1, 0, map);
                break;
        }

        CheckEvents();
    }

    void CheckEvents()
    {
        if (inCorridor)
        {
            // Monter (si pas dernier étage)
            if (currentFloor < 3 &&
                AllRoomsCompleted() &&
                player.X == map.StairsX &&
                player.Y == map.StairsY)
            {
                GoUp();
                return;
            }

            // Descendre
            if (currentFloor > 1 &&
                player.X == 0 &&
                player.Y == 0)
            {
                GoDown();
                return;
            }

            // Portes
            for (int i = 0; i < doors.Length; i++)
            {
                if (player.X == doors[i].x &&
                    player.Y == doors[i].y)
                {
                    EnterRoom(i);
                    return;
                }
            }
        }
        else
        {
            if (player.X == exitDoorInRoom.x &&
                player.Y == exitDoorInRoom.y)
            {
                ReturnToCorridor();
                return;
            }

            if (!CurrentRoomsCompleted()[currentRoom] &&
                player.X == map.BossX &&
                player.Y == map.BossY)
            {
                showBoss = true;
            }
        }
    }

    void GoUp()
    {
        currentFloor++;
        map = new Map(10, 10, currentFloor);

        // spawn en haut à gauche, à côté de ⬇️
        player = new Player(1, 0);
        inCorridor = true;
    }

    void GoDown()
    {
        currentFloor--;
        map = new Map(10, 10, currentFloor);

        // spawn devant l’escalier ⬆️
        player = new Player(map.StairsX, map.StairsY - 1);
        inCorridor = true;
    }

    void EnterRoom(int roomIndex)
    {
        currentRoom = roomIndex;
        inCorridor = false;

        map = new Map(10, 10, currentFloor);
        exitDoorInRoom = (0, map.Height / 2);
        player = new Player(exitDoorInRoom.x + 1, exitDoorInRoom.y);

        boss = BossFactory.CreateBoss(currentFloor, roomIndex + 1);
        showBoss = false;
    }

    void AnswerBoss(int index)
    {
        bool finished = boss!.Answer(index);
        if (!finished) return;

        showBoss = false;

        if (boss.Defeated)
            CurrentRoomsCompleted()[currentRoom] = true;
        else
            floorsProgress[currentFloor] = new bool[3];
    }

    void ReturnToCorridor()
    {
        inCorridor = true;
        map = new Map(10, 10, currentFloor);
        player = new Player(doors[currentRoom].x, doors[currentRoom].y + 1);
    }
}
