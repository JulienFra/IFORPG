@page "/game"
@using ifoRPG.Models
@inject NavigationManager NavManager

<h3>ifoRPG</h3>

<div class="game-layout">

    <div class="left-panel">
        <p><b>Inventaire</b></p>
        @if (!player.Inventory.Items.Any())
        {
            <p>(vide)</p>
        }
        else
        {
            @foreach (var item in player.Inventory.Items)
            {
                <p>📦 @item.Name</p>
            }
        }
    </div>

    <div class="center-panel">
        <div class="map" tabindex="0" @onkeydown="HandleKey" @ref="gameDiv">

            @for (int y = 0; y < map.Height; y++)
            {
                <div class="row">
                    @for (int x = 0; x < map.Width; x++)
                    {
                        @* 1. INITIALISATION DES CLASSES *@
                        string tileClass = "floor";
                        string rotationClass = "";

                        @* 2. LOGIQUE DES TUILES DE DÉCOR *@
                        if (!state.InCorridor && map.Tiles[x, y].Type == TileType.PC)
                        {
                            tileClass = "tile-pc";
                            if (x == 7 && (y == 4 || y == 5 || y == 6)) { rotationClass = "right"; }
                            else if (y == 3 && x >= 1 && x <= 7) { rotationClass = "up"; }
                        }
                        else if ((state.InCorridor && (x == 2 || x == 5 || x == 8) && y == 4) ||
                        (!state.InCorridor && x == 0 && y == 5))
                        {
                            tileClass = "tile-door";
                        }
                        else if (!state.InCorridor && map.Tiles[x, y].Type == TileType.Window)
                        {
                            tileClass = "tile-window";
                        }
                        else if (map.Tiles[x, y].Type == TileType.Flower)
                        {
                            tileClass = "tile-flower";
                        }
                        else if (state.InCorridor && x == map.StairsX && y == map.StairsY)
                        {
                            if (state.CurrentFloor < 2)
                            {
                                tileClass = state.FloorsProgress[state.CurrentFloor].All(r => r)
                                ? "tile-stairs"
                                : "tile-no-entry";
                            }
                            else if (state.CurrentFloor == 2)
                            {
                                tileClass = state.FloorsProgress[state.CurrentFloor].All(r => r) ? "tile-stairs" : "floor";
                            }
                        }
                        else if (state.InCorridor && state.CurrentFloor > 1 && x == 0 && y == 0)
                        {
                            tileClass = "tile-stairs";
                        }

                        @* 3. RENDU DE LA CASE *@
                        <div class="tile @tileClass @rotationClass">
                            @if (player.X == x && player.Y == y)
                            {
                                @* L'avatar s'adapte grâce à la classe dynamique *@
                                <div class="player @player.Avatar"></div>
                            }
                            else if (!state.InCorridor && !state.FloorsProgress[state.CurrentFloor][state.CurrentRoomIndex]
                            && x == map.BossX && y == map.BossY)
                            {
                                if (state.CurrentFloor == 1 && state.CurrentRoomIndex == 0) { <div class="boss-jeremy"></div> }
                                else if (state.CurrentFloor == 1 && state.CurrentRoomIndex == 1) { <div class="boss-cedric"></div> }
                                else if (state.CurrentFloor == 1 && state.CurrentRoomIndex == 2) { <div class="boss-bernair"></div> }
                                else if (state.CurrentFloor == 2 && state.CurrentRoomIndex == 0) { <div class="boss-six"></div> }
                                else if (state.CurrentFloor == 2 && state.CurrentRoomIndex == 1) { <div class="boss-martin"></div> }
                                else if (state.CurrentFloor == 2 && state.CurrentRoomIndex == 2) { <div class="boss-christophe"></div> }
                                else { <span class="boss-icon">👹</span> }
                            }
                            else if (!state.InCorridor && map.Tiles[x, y].Type == TileType.Board)
                            {
                                <span class="boss-icon">👨‍🏫</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @if (gameWon)
    {
        <div class="victory-overlay">
            <div class="victory-card">
                <h1>🎓 DIPLÔME OBTENU !</h1>
                <p>Félicitations ! Tu as vaincu tous les professeurs de l'IFOSUP.</p>
                <p>Tu es maintenant un développeur certifié.</p>
                <button class="btn-restart" @onclick="RestartGame">Recommencer</button>
            </div>
        </div>
    }

    <div class="right-panel">
        <div class="quest-book">
            <p><b>Quest Book</b></p>
            <p>Étage @state.CurrentFloor</p>
            <ul>
                @for (int i = 0; i < 3; i++)
                {
                    <li>
                        Salle @(i + 1) :
                        @(state.FloorsProgress[state.CurrentFloor][i] ? "✅" : "❌")
                    </li>
                }
            </ul>
        </div>

        @if (!state.InCorridor && state.ShowBoss && state.CurrentBoss != null)
        {
            <div class="boss">
                @if (player.Inventory.HasChatGPT())
                {
                    <button class="btn-primary" @onclick="UseChatGPT">
                        🤖 Utiliser ChatGPT (réussite automatique)
                    </button>
                }
                <h3>👨‍🏫 @state.CurrentBoss.Name</h3>

                @if (!state.IntroductionRead)
                {
                    <div class="boss-intro">
                        @if (state.CurrentBoss.Name == "Monsieur Kairis") { <p><i>"Je suis Jeremy, un prof redoutable. Pour passer à la salle suivante, tu vas devoir prouver ta maîtrise de la POO !"</i></p> }
                        else if (state.CurrentBoss.Name == "Cédric") { <p><i>"Bonjour ! Vérifie tes câbles et ton masque de sous-réseau. Si ton paquet n'arrive pas à destination, tu ne passeras pas l'examen !"</i></p> }
                        else if (state.CurrentBoss.Name == "Monsieur Bernair") { <p><i>"Sortez vos feuilles, nous allons analyser la structure de votre projet. Pas d'implémentation sans une bonne modélisation !"</i></p> }
                        else if (state.CurrentBoss.Name == "Monsieur Six") { <p><i>"Bonjour. J'espère que vos index sont bien posés et vos requêtes optimisées. Prêt pour un petit SELECT ?"</i></p> }
                        else if (state.CurrentBoss.Name == "Monsieur Martin") { <p><i>"Une base de données sans requêtes propres n'est qu'un tas de fichiers. Montrez-moi que vous maîtrisez le langage SQL !"</i></p> }
                        else if (state.CurrentBoss.Name == "Christophe") { <p><i>"Salut ! J'espère que vous avez révisé vos callbacks et que votre code n'est pas trop bloquant. Prêt à rendre cette page interactive ?"</i></p> }
                        else { <p><i>"Préparez-vous pour l'examen..."</i></p> }
                        <button class="btn-primary" @onclick="() => state.IntroductionRead = true">Commencer l'examen</button>
                    </div>
                }
                else if (state.CurrentBoss.CurrentQuestion != null)
                {
                    <p><b>Question @(state.CurrentBoss.CurrentQuestionIndex + 1) / @state.CurrentBoss.Questions.Count</b></p>
                    <p>@state.CurrentBoss.CurrentQuestion.Text</p>

                    <div class="answers-grid">
                        @for (int i = 0; i < state.CurrentBoss.CurrentQuestion.Answers.Count; i++)
                        {
                            int index = i;
                            <button class="btn-answer" @onclick="() => AnswerBoss(index)">
                                @state.CurrentBoss.CurrentQuestion.Answers[index]
                            </button>
                        }
                    </div>
                    <p><small>Réponses correctes : @state.CurrentBoss.CorrectAnswers / 4 requis</small></p>
                }
            </div>
        }
    </div>
</div>

@code {
    GameState state = new GameState();
    ElementReference gameDiv;
    bool gameWon = false;

    private Player player => state.Player;
    private Map map => state.CurrentMap;

    protected override void OnInitialized()
{
    // On récupère l'URL complète (ex: http://localhost:5000/game?avatar=female)
    var uri = NavManager.Uri;

    if (uri.Contains("avatar=female"))
    {
        state.Player.Avatar = "female";
    }
    else
    {
        state.Player.Avatar = "male"; // Par défaut
    }
}

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await gameDiv.FocusAsync();
    }

    void HandleKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "z": case "ArrowUp": player.Move(0, -1, map); break;
            case "s": case "ArrowDown": player.Move(0, 1, map); break;
            case "q": case "ArrowLeft": player.Move(-1, 0, map); break;
            case "d": case "ArrowRight": player.Move(1, 0, map); break;
        }
        CheckEvents();
    }

    void CheckEvents()
    {
        if (state.InCorridor && !state.ChatGPTPicked && player.X == map.Width - 1 && player.Y == 0)
        {
            state.TryPickupChatGPT();
            StateHasChanged();
        }

        if (state.InCorridor)
        {
            bool[] currentFloorProgress = state.FloorsProgress[state.CurrentFloor];
            bool allDone = currentFloorProgress.All(r => r);

            if (player.X == map.StairsX && player.Y == map.StairsY && allDone)
            {
                if (state.CurrentFloor == 2)
                {
                    gameWon = true;
                    StateHasChanged();
                }
                else if (state.CurrentFloor < 2)
                {
                    state.GoUp();
                    StateHasChanged();
                }
            }
            else if (state.CurrentFloor > 1 && player.X == 0 && player.Y == 0)
            {
                state.GoDown();
                StateHasChanged();
            }

            int[] doorX = { 2, 5, 8 };
            for (int i = 0; i < doorX.Length; i++)
            {
                if (player.X == doorX[i] && player.Y == 4)
                {
                    state.EnterRoom(i);
                    StateHasChanged();
                }
            }
        }
        else
        {
            if (player.X == 0 && player.Y == 5)
            {
                state.ReturnToCorridor();
                StateHasChanged();
            }

            if (!state.FloorsProgress[state.CurrentFloor][state.CurrentRoomIndex] &&
                player.X == map.BossX && player.Y == map.BossY)
            {
                state.ShowBoss = true;
                StateHasChanged();
            }
        }
    }

    void AnswerBoss(int index)
    {
        if (state.CurrentBoss == null) return;
        bool finished = state.CurrentBoss.Answer(index);
        if (finished) state.HandleBossDefeat(state.CurrentBoss.Defeated);
    }

    void UseChatGPT()
    {
        state.UseChatGPTOnBoss();
        state.HandleBossDefeat(true);
    }

    void RestartGame()
    {
        state = new GameState();
        gameWon = false;
        StateHasChanged();
    }
}