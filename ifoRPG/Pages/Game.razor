@page "/game"
@using ifoRPG.Models
@using Microsoft.AspNetCore.Components.Web

<h3>ifoRPG</h3>

<div class="game-layout">

    <!-- INVENTAIRE -->
    <div class="left-panel">
        <p><b>Inventaire</b></p>

        @if (!player.Inventory.Items.Any())
        {
            <p>(vide)</p>
        }
        else
        {
            @foreach (var item in player.Inventory.Items)
            {
                <p>📦 @item.Name</p>
            }
        }
    </div>

    <!-- MAP -->
    <div class="center-panel">
        <div class="map" tabindex="0" @onkeydown="HandleKey" @ref="gameDiv">

            @for (int y = 0; y < map.Height; y++)
            {
                <div class="row">
                    @for (int x = 0; x < map.Width; x++)
                    {
                        if (player.X == x && player.Y == y)
                        {
                            <span class="tile player">🙂</span>
                        }
                        else if (!chatGPTTaken &&
                        x == map.ChatGPTX &&
                        y == map.ChatGPTY)
                        {
                            <span class="tile">🤖</span>
                        }
                        else if (!boss.Defeated &&
                        x == map.BossX &&
                        y == map.BossY)
                        {
                            <span class="tile">👹</span>
                        }
                        else if (stairsUnlocked &&
                        x == map.StairsX &&
                        y == map.StairsY)
                        {
                            <span class="tile">⬇️</span>
                        }
                        else
                        {
                            var currentTile = map.Tiles[x, y];
                            @if (currentTile.Type == TileType.Window)
                            {
                                <span class="tile">🪟</span>
                            }
                            else if (currentTile.Type == TileType.Bench)
                            {

                                <span class="tile">🪑</span>
                            }
                            else if (currentTile.Type == TileType.PC)
                            {

                                <span class="tile">💻</span>
                            }
                            else
                            {

                                <span class="tile">.</span>
                            }
                        }
                    }
                </div>
            }
        </div>
    </div>

    <!-- QUEST BOOK + QCM -->
    <div class="right-panel">

        <!-- QUEST BOOK -->
        <div class="quest-book">
            <p><b>Quest Book</b></p>

            @if (!floor1Quest.Completed)
            {
                <p>@floor1Quest.Description</p>
            }
            else
            {
                <p style="color: green;">✅ Étape 1 validée</p>
            }
        </div>

        <!-- BOSS -->
        @if (showBoss)
        {
            <div class="boss">
                <h3>👹 @boss.Name</h3>

                @if (player.Inventory.HasChatGPT())
                {
                    <button @onclick="CheatWithChatGPT">
                        🤖 Tricher avec ChatGPT
                    </button>
                }

                <p>@boss.CurrentQuestion.Text</p>

                @for (int i = 0; i < boss.CurrentQuestion.Answers.Count; i++)
                {
                    int index = i;
                    <button @onclick="() => AnswerBoss(index)">
                        @boss.CurrentQuestion.Answers[i]
                    </button>
                }

                <p>@bossResult</p>
            </div>
        }
    </div>

</div>

@code {
    int currentFloor = 1;
    Map map = new Map(10, 10, 1); Player player = new Player(0, 0);

    Quest floor1Quest = new Quest("Réussir étage 1");

    Boss? boss;

    bool showBoss = false;
    bool stairsUnlocked = false;
    bool chatGPTTaken = false;
    string bossResult = "";

    ElementReference gameDiv;
    protected override void OnInitialized()
    {
        boss = Boss.CreateBossForFloor(currentFloor);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await gameDiv.FocusAsync();
    }

    void HandleKey(KeyboardEventArgs e)
    {
        if (showBoss)
            return;

        switch (e.Key)
        {
            case "z":
            case "ArrowUp":
                player.Move(0, -1, map);
                break;
            case "s":
            case "ArrowDown":
                player.Move(0, 1, map);
                break;
            case "q":
            case "ArrowLeft":
                player.Move(-1, 0, map);
                break;
            case "d":
            case "ArrowRight":
                player.Move(1, 0, map);
                break;
        }

        CheckEvents();
    }

    void CheckEvents()
    {
        // Pickup ChatGPT
        if (!chatGPTTaken &&
        player.X == map.ChatGPTX &&
        player.Y == map.ChatGPTY)
        {
            player.Inventory.Add(new ChatGPTItem());
            chatGPTTaken = true;
        }

        // Boss
        if (!boss.Defeated &&
        player.X == map.BossX &&
        player.Y == map.BossY)
        {
            showBoss = true;
        }

        // Stairs
        if (stairsUnlocked &&
        player.X == map.StairsX &&
        player.Y == map.StairsY)
        {
            NextFloor();
        }
    }

    void NextFloor()
    {
        currentFloor++; // On passe à l'étage 2, 3, etc.

        // On crée la map AVEC le nouvel étage
        map = new Map(10, 10, currentFloor);

        player = new Player(0, 0);
        boss = Boss.CreateBossForFloor(currentFloor);

        // On reset les drapeaux pour le nouvel étage
        stairsUnlocked = false;
        chatGPTTaken = false;
        showBoss = false;
        bossResult = $"Bienvenue à l'étage {currentFloor} !";

        StateHasChanged();
    }

    void AnswerBoss(int index)
    {
        // 1. On enregistre la réponse dans l'objet boss
        bool finished = boss!.Answer(index);

        // 2. Si le QCM est fini (après 3 questions)
        if (finished)
        {
            if (boss.Defeated)
            {
                // IMPORTANT : On appelle WinBoss ici pour ouvrir la porte
                WinBoss();
            }
            else
            {
                // Si raté, on recommence l'étage
                ResetFloor();
            }

            showBoss = false; // On ferme la fenêtre de dialogue
        }

        StateHasChanged(); // On force le rafraîchissement
    }

    void CheatWithChatGPT()
    {
        player.Inventory.UseChatGPT();
        WinBoss();
        showBoss = false;
    }

    void WinBoss()
    {
        bossResult = "✅ Examen réussi ! La sortie est ouverte.";
        stairsUnlocked = true; // C'est CA qui fait apparaître la flèche ⬇️
        boss!.Defeated = true;
        StateHasChanged();
    }

    void ResetFloor()
    {
        player = new Player(0, 0);
        boss = Boss.CreateBossForFloor(currentFloor); stairsUnlocked = false;
        chatGPTTaken = false;
        floor1Quest.Reset();
    }

   
}