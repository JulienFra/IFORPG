@page "/"
@inject NavigationManager NavManager

<div class="main-screen">
    <div class="menu-card">
        <div class="header-section">
            <h1 class="game-title">IFO RPG</h1>
            <p class="game-subtitle">L'aventure au cœur de l'IFOSUP</p>
        </div>

        <div class="content-scroll-area">
            <div class="description-section">
                <h3>📖 L'Histoire</h3>
                <p>
                    Incarnez un nouvel étudiant dans une école mystérieuse. 
                    Chaque salle cache un défi intellectuel gardé par un professeur redoutable.
                </p>

                <h3>🎮 Règles du Jeu</h3>
                <ul>
                    <li>🏃 <b>Z, Q, S, D</b> pour se déplacer.</li>
                    <li>🚪 Entrez dans les salles pour affronter les Boss.</li>
                    <li>👹 Gagnez pour valider la salle.</li>
                </ul>
            </div>
        </div>

        <div class="action-area">
            <button class="play-button" @onclick="StartGame">
                 LANCER L'EXAMEN
            </button>
        </div>
    </div>
</div>

@code {
    void StartGame()
    {
        NavManager.NavigateTo("game");
    }
}

<style>
    .main-screen {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        width: 100vw;
        background-color: #1a1a1a;
        overflow: hidden;
        padding: 20px;
        box-sizing: border-box;
    }

    .menu-card {
        background-color: #2c2c2c;
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 500px;
        max-height: 90vh;
        padding: 30px;
        border-radius: 15px;
        border: 4px solid #444;
        box-shadow: 0 0 30px rgba(0,0,0,0.5);
        color: #eee;
    }

    .header-section {
        flex-shrink: 0;
        text-align: center;
        margin-bottom: 15px;
    }

    .game-title {
        font-size: clamp(2rem, 8vw, 3.5rem);
        color: #4CAF50;
        margin: 0;
        text-shadow: 3px 3px #000;
    }

    .game-subtitle {
        color: #aaa;
        font-size: 1.1rem;
        margin-top: 5px;
    }

    .content-scroll-area {
        flex-grow: 1;
        overflow-y: auto; 
        margin-bottom: 20px;
        padding-right: 10px;
    }

    .description-section {
        background: #222;
        padding: 15px;
        border-radius: 8px;
        border-left: 5px solid #4CAF50;
    }

    .description-section h3 {
        color: #4CAF50;
        margin-top: 15px;
        margin-bottom: 10px;
        font-size: 1.1rem;
    }

    .description-section p, .description-section li {
        font-size: 0.9rem;
        color: #ccc;
        margin-bottom: 8px;
    }

    .description-section ul {
        padding-left: 20px;
    }

    .play-button {
        padding: 15px;
        font-size: 1.2rem;
        font-weight: bold;
        cursor: pointer;
        background-color: #4CAF50;
        color: white;
        border: none;
        border-radius: 10px;
        box-shadow: 0 4px #2e7d32;
        width: 100%;
        transition: all 0.1s;
    }

    .play-button:hover { background-color: #45a049; }
    .play-button:active { transform: translateY(4px); box-shadow: 0 0px; }
</style>